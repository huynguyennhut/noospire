<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} - Executive Summary - Noosforge Sentinel</title>
  <style>
    :root, [data-theme='dark'] {
      --bg-primary: #070B14;
      --bg-surface: #0E1526;
      --bg-surface-hover: #162038;
      --border-subtle: #1F2E4D;
      --border-strong: #2D426B;
      --text-primary: #F1F5F9;
      --text-secondary: #94A3B8;
      --text-muted: #64748B;
      --severity-critical: #EF4444;
      --severity-high: #F97316;
      --severity-medium: #F59E0B;
      --severity-low: #10B981;
      --severity-info: #06B6D4;
      --accent-cyan: #06B6D4;
    }

    .theme-warm,
    [data-theme='warm'],
    body.theme-warm {
      --bg-primary: #FAF8F5;
      --bg-surface: #FFFFFF;
      --bg-surface-hover: #F4EFEA;
      --border-subtle: rgba(0, 0, 0, 0.08);
      --border-strong: rgba(0, 0, 0, 0.16);
      --text-primary: #18181B;
      --text-secondary: #52525B;
      --text-muted: #71717A;
      --severity-critical: #DC2626;
      --severity-high: #EA580C;
      --severity-medium: #D97706;
      --severity-low: #059669;
      --severity-info: #0891B2;
      --accent-cyan: #0891B2;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-primary);
      color: var(--text-primary);
      line-height: 1.6;
      padding: 3rem 1.5rem;
    }
    .container { max-width: 960px; margin: 0 auto; }
    .header-banner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid var(--border-subtle);
      padding-bottom: 1.5rem;
      margin-bottom: 2rem;
    }
    .brand-title {
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--accent-cyan);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .badge-ciso {
      background: rgba(6, 182, 212, 0.15);
      color: var(--accent-cyan);
      border: 1px solid var(--accent-cyan);
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .title { font-size: 2.25rem; font-weight: 800; margin-bottom: 0.5rem; }
    .subtitle { color: var(--text-secondary); font-size: 1.1rem; margin-bottom: 2rem; }

    .score-banner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: linear-gradient(135deg, rgba(14, 21, 38, 0.9), rgba(31, 46, 77, 0.6));
      border: 1px solid var(--border-strong);
      border-radius: 0.75rem;
      padding: 2rem;
      margin-bottom: 2.5rem;
    }
    .score-number {
      font-size: 3.5rem;
      font-weight: 900;
      color: var(--severity-high);
      line-height: 1;
    }
    .score-desc { max-width: 600px; color: var(--text-secondary); font-size: 0.95rem; }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      margin-bottom: 2.5rem;
    }
    .stat-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 0.5rem;
      padding: 1.25rem;
      text-align: center;
    }
    .stat-val { font-size: 2rem; font-weight: 800; color: var(--text-primary); margin-top: 0.25rem; }
    .stat-lbl { font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600; }

    .section-title {
      font-size: 1.35rem;
      font-weight: 700;
      margin-bottom: 1rem;
      color: var(--text-primary);
      border-bottom: 1px solid var(--border-subtle);
      padding-bottom: 0.5rem;
    }

    .priority-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 2.5rem;
    }
    .priority-item {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-left: 4px solid var(--severity-critical);
      border-radius: 0.5rem;
      padding: 1.25rem;
    }
    .priority-item.high { border-left-color: var(--severity-high); }
    .priority-item.medium { border-left-color: var(--severity-medium); }
    .priority-title { font-weight: 700; font-size: 1.05rem; margin-bottom: 0.25rem; }
    .priority-body { color: var(--text-secondary); font-size: 0.9rem; }

    @media print {
      body { background: #fff; color: #0F172A; padding: 0; }
      .container { max-width: 100%; }
      .score-banner, .stat-card, .priority-item { background: #F8FAFC; border: 1px solid #CBD5E1; color: #0F172A; }
      .score-desc, .priority-body { color: #475569; }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header-banner">
      <div class="brand-title">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        NOOSFORGE SENTINEL
      </div>
      <div style="display: flex; gap: 0.75rem; align-items: center;">
        <button onclick="toggleTheme()" id="themeBtn" style="background: var(--bg-surface); color: var(--text-primary); border: 1px solid var(--border-subtle); padding: 0.35rem 0.75rem; border-radius: 0.375rem; cursor: pointer; font-size: 0.8rem; font-weight: 600;">Theme: Warm Light</button>
        <div class="badge-ciso">EXECUTIVE BRIEFING // CISO REPORT</div>
      </div>
    </div>

    <h1 class="title">{{ title }}</h1>
    <div class="subtitle">Executive Risk Posture & Strategic Remediation Summary</div>

    <div class="score-banner">
      <div>
        <div style="font-size: 0.85rem; font-weight: 700; text-transform: uppercase; color: var(--accent-cyan); margin-bottom: 0.25rem;">Composite Security Posture</div>
        <div class="score-desc">
          Automated multi-factor evaluation of <strong>{{ target_scope }}</strong> combining inherent CVSS severity, FIRST EPSS exploitability probability, CISA KEV active threats, and asset network exposure.
        </div>
      </div>
      <div style="text-align: right;">
        <div class="score-number">{{ risk_summary.overall_risk_score }}</div>
        <div style="font-weight: 700; color: var(--severity-high); text-transform: uppercase;">{{ risk_summary.risk_posture }}</div>
      </div>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-lbl">Total Findings</div>
        <div class="stat-val">{{ risk_summary.total_findings }}</div>
      </div>
      <div class="stat-card">
        <div class="stat-lbl">Critical & High</div>
        <div class="stat-val" style="color: var(--severity-critical);">{{ risk_summary.critical_count + risk_summary.high_count }}</div>
      </div>
      <div class="stat-card">
        <div class="stat-lbl">Active KEV Exploits</div>
        <div class="stat-val" style="color: var(--severity-critical);">{{ risk_summary.cisa_kev_count }}</div>
      </div>
      <div class="stat-card">
        <div class="stat-lbl">EPSS > 50%</div>
        <div class="stat-val" style="color: var(--severity-high);">{{ risk_summary.high_epss_count }}</div>
      </div>
    </div>

    <h2 class="section-title">1. Top Strategic Remediation Priorities</h2>
    <div class="priority-list">
      <div class="priority-item">
        <div class="priority-title">Priority 1: Immediate Remediation of CISA KEV Vulnerabilities</div>
        <div class="priority-body">
          Identified {{ risk_summary.cisa_kev_count }} vulnerability instance(s) confirmed to be under active in-the-wild exploitation. These present the highest probability of immediate compromise and must be patched or mitigated within 24–48 hours.
        </div>
      </div>
      <div class="priority-item high">
        <div class="priority-title">Priority 2: Patch High-Probability Weaponized Attack Vectors</div>
        <div class="priority-body">
          Focus engineering resources on the {{ risk_summary.critical_count }} Critical and {{ risk_summary.high_count }} High severity issues, specifically those with EPSS exploit probabilities exceeding 50% on exposed endpoints.
        </div>
      </div>
      <div class="priority-item medium">
        <div class="priority-title">Priority 3: Enforce Continuous Automated Scanner Gating in CI/CD</div>
        <div class="priority-body">
          Integrate Sentinel's Trivy, Nuclei, and ZAP baseline scanning into pre-production release pipelines to prevent regressions and vulnerable open-source dependencies from reaching production.
        </div>
      </div>
    </div>

    <h2 class="section-title">2. Scope & Assessment Summary</h2>
    <p style="color: var(--text-secondary); margin-bottom: 2rem; font-size: 0.95rem;">
      Scope: <strong>{{ target_scope }}</strong> &bull; Generated: <strong>{{ generated_at }}</strong> &bull; Auditor: <strong>Noosforge Sentinel Security Engine</strong>.
      All metrics are derived with 100% fidelity from verified database records with zero data fabrication.
    </p>

    <h2 class="section-title">3. Coverage Gaps & Exclusions</h2>
    <div class="stats-grid" style="grid-template-columns: repeat(2, 1fr); margin-bottom: 1.5rem;">
      <div class="stat-card">
        <div class="stat-lbl">Scope Coverage Ratio</div>
        <div class="stat-val" style="color: var(--accent-cyan);">{{ coverage_metrics.coverage_pct if coverage_metrics and coverage_metrics.coverage_pct is defined else '100.0' }}%</div>
      </div>
      <div class="stat-card">
        <div class="stat-lbl">Exclusions / Unassessed Gaps</div>
        <div class="stat-val">{{ coverage_gaps|length if coverage_gaps else 0 }}</div>
      </div>
    </div>

    {% if coverage_gaps %}
    <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 0.5rem; padding: 1.25rem; margin-bottom: 2rem;">
      <div style="font-weight: 700; margin-bottom: 0.75rem; color: var(--severity-high);">Audit Disclosure of Unassessed Execution Targets:</div>
      <ul style="padding-left: 1.5rem; color: var(--text-secondary); font-size: 0.9rem;">
        {% for gap in coverage_gaps %}
        <li style="margin-bottom: 0.5rem;">
          <strong>{{ gap.target_locator or gap.target }}</strong> ({{ gap.engine }}): <span style="color: var(--severity-high);">{{ gap.status }}</span> — {{ gap.reason }}
        </li>
        {% endfor %}
      </ul>
    </div>
    {% else %}
    <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 0.5rem; padding: 1.25rem; margin-bottom: 2rem; color: var(--severity-low);">
      <strong>Full Assessment Integrity:</strong> 100% of approved in-scope execution targets and security checks executed successfully without timeouts, authorization denials, or unhandled exclusions.
    </div>
    {% endif %}
  </div>

  <script>
    function toggleTheme() {
      const doc = document.documentElement;
      const current = doc.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'warm' : 'dark';
      doc.setAttribute('data-theme', next);
      doc.classList.toggle('theme-warm', next === 'warm');
      document.body.classList.toggle('theme-warm', next === 'warm');
      const btn = document.getElementById('themeBtn');
      if (btn) {
        btn.textContent = next === 'warm' ? 'Theme: Obsidian Dark' : 'Theme: Warm Light';
      }
    }
  </script>
</body>
</html>
