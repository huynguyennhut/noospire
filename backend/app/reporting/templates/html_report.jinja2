<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} - Noosforge Sentinel</title>
  <style>
    :root, [data-theme='dark'] {
      --bg-primary: #070B14;
      --bg-surface: #0E1526;
      --bg-surface-hover: #162038;
      --border-subtle: #1F2E4D;
      --border-strong: #2D426B;
      --text-primary: #F1F5F9;
      --text-secondary: #94A3B8;
      --text-muted: #64748B;
      --severity-critical: #EF4444;
      --severity-high: #F97316;
      --severity-medium: #F59E0B;
      --severity-low: #10B981;
      --severity-info: #06B6D4;
      --accent-cyan: #06B6D4;
    }

    .theme-warm,
    [data-theme='warm'],
    body.theme-warm {
      --bg-primary: #FAF8F5;
      --bg-surface: #FFFFFF;
      --bg-surface-hover: #F4EFEA;
      --border-subtle: rgba(0, 0, 0, 0.08);
      --border-strong: rgba(0, 0, 0, 0.16);
      --text-primary: #18181B;
      --text-secondary: #52525B;
      --text-muted: #71717A;
      --severity-critical: #DC2626;
      --severity-high: #EA580C;
      --severity-medium: #D97706;
      --severity-low: #059669;
      --severity-info: #0891B2;
      --accent-cyan: #0891B2;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-primary);
      color: var(--text-primary);
      line-height: 1.5;
      padding: 2.5rem 1.5rem;
    }

    .container {
      max-width: 1040px;
      margin: 0 auto;
    }

    .header-banner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid var(--border-subtle);
      padding-bottom: 1.5rem;
      margin-bottom: 2rem;
    }

    .brand-title {
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -0.025em;
      color: var(--accent-cyan);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .badge-confidential {
      background: rgba(239, 68, 68, 0.2);
      color: var(--severity-critical);
      border: 1px solid var(--severity-critical);
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .report-title {
      font-size: 2.25rem;
      font-weight: 800;
      margin-bottom: 0.5rem;
      color: var(--text-primary);
    }

    .report-subtitle {
      color: var(--text-secondary);
      font-size: 1.1rem;
      margin-bottom: 1.5rem;
    }

    .meta-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 0.5rem;
      padding: 1.25rem;
      margin-bottom: 2rem;
    }

    .meta-item .meta-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      margin-bottom: 0.25rem;
    }

    .meta-item .meta-value {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--text-primary);
    }

    .stats-row {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 0.75rem;
      margin-bottom: 2.5rem;
    }

    .stat-card {
      padding: 1rem;
      border-radius: 0.5rem;
      text-align: center;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
    }

    .stat-card.critical { border-top: 4px solid var(--severity-critical); }
    .stat-card.high { border-top: 4px solid var(--severity-high); }
    .stat-card.medium { border-top: 4px solid var(--severity-medium); }
    .stat-card.low { border-top: 4px solid var(--severity-low); }
    .stat-card.info { border-top: 4px solid var(--severity-info); }

    .stat-number {
      font-size: 1.75rem;
      font-weight: 800;
      margin-top: 0.25rem;
    }

    .section-title {
      font-size: 1.35rem;
      font-weight: 700;
      margin-bottom: 1rem;
      color: var(--text-primary);
      border-bottom: 1px solid var(--border-subtle);
      padding-bottom: 0.5rem;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 2.5rem;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 0.5rem;
      overflow: hidden;
    }

    th, td {
      padding: 0.75rem 1rem;
      text-align: left;
      border-bottom: 1px solid var(--border-subtle);
      font-size: 0.875rem;
    }

    th {
      background: rgba(31, 46, 77, 0.4);
      color: var(--text-secondary);
      font-weight: 600;
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 0.05em;
    }

    tr:hover {
      background: var(--bg-surface-hover);
    }

    .sev-badge {
      display: inline-block;
      padding: 0.2rem 0.6rem;
      border-radius: 0.25rem;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      color: #fff;
    }

    .sev-badge.CRITICAL { background: var(--severity-critical); }
    .sev-badge.HIGH { background: var(--severity-high); }
    .sev-badge.MEDIUM { background: var(--severity-medium); }
    .sev-badge.LOW { background: var(--severity-low); }
    .sev-badge.INFO { background: var(--severity-info); }

    .dossier-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 0.5rem;
      padding: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .dossier-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 1rem;
      gap: 1rem;
    }

    .dossier-title {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text-primary);
    }

    .dossier-meta {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 0.75rem;
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .dossier-meta strong {
      color: var(--text-secondary);
    }

    .evidence-block {
      background: #020617;
      border: 1px solid var(--border-subtle);
      border-radius: 0.375rem;
      padding: 1rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.8rem;
      color: #94A3B8;
      overflow-x: auto;
      white-space: pre-wrap;
      margin: 0.75rem 0;
    }

    .remediation-block {
      background: rgba(6, 182, 212, 0.08);
      border-left: 3px solid var(--accent-cyan);
      padding: 0.75rem 1rem;
      font-size: 0.875rem;
      border-radius: 0 0.375rem 0.375rem 0;
      margin-top: 0.75rem;
    }

    @media print {
      body {
        background: #fff;
        color: #0F172A;
        padding: 0;
      }
      .container { max-width: 100%; }
      .meta-grid, table, .dossier-card {
        background: #fff;
        border: 1px solid #CBD5E1;
      }
      .brand-title { color: #0284C7; }
      th { background: #F1F5F9; color: #475569; }
      td, .dossier-title { color: #0F172A; }
      .evidence-block { background: #F8FAFC; color: #1E293B; border-color: #E2E8F0; }
      .remediation-block { background: #F0FDF4; border-color: #10B981; color: #166534; }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header-banner">
      <div class="brand-title">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        NOOSFORGE SENTINEL
      </div>
      <div style="display: flex; gap: 0.75rem; align-items: center;">
        <button onclick="toggleTheme()" id="themeBtn" style="background: var(--bg-surface); color: var(--text-primary); border: 1px solid var(--border-subtle); padding: 0.35rem 0.75rem; border-radius: 0.375rem; cursor: pointer; font-size: 0.8rem; font-weight: 600;">Theme: Warm Light</button>
        <div class="badge-confidential">CONFIDENTIAL AUDIT</div>
      </div>
    </div>

    <h1 class="report-title">{{ title }}</h1>
    <div class="report-subtitle">Technical Security Assessment & Continuous Intelligence Audit</div>

    <div class="meta-grid">
      <div class="meta-item">
        <div class="meta-label">Target Scope</div>
        <div class="meta-value">{{ target_scope }}</div>
      </div>
      <div class="meta-item">
        <div class="meta-label">Generated Timestamp</div>
        <div class="meta-value">{{ generated_at }}</div>
      </div>
      <div class="meta-item">
        <div class="meta-label">Sentinel Risk Index</div>
        <div class="meta-value" style="color: var(--severity-high);">{{ risk_summary.overall_risk_score }} / 100 ({{ risk_summary.risk_posture }})</div>
      </div>
      <div class="meta-item">
        <div class="meta-label">Assessment Engine</div>
        <div class="meta-value">Nuclei, OWASP ZAP, Trivy</div>
      </div>
    </div>

    <div class="stats-row">
      <div class="stat-card critical">
        <div class="meta-label" style="color: var(--severity-critical);">CRITICAL</div>
        <div class="stat-number" style="color: var(--severity-critical);">{{ risk_summary.critical_count }}</div>
      </div>
      <div class="stat-card high">
        <div class="meta-label" style="color: var(--severity-high);">HIGH</div>
        <div class="stat-number" style="color: var(--severity-high);">{{ risk_summary.high_count }}</div>
      </div>
      <div class="stat-card medium">
        <div class="meta-label" style="color: var(--severity-medium);">MEDIUM</div>
        <div class="stat-number" style="color: var(--severity-medium);">{{ risk_summary.medium_count }}</div>
      </div>
      <div class="stat-card low">
        <div class="meta-label" style="color: var(--severity-low);">LOW</div>
        <div class="stat-number" style="color: var(--severity-low);">{{ risk_summary.low_count }}</div>
      </div>
      <div class="stat-card info">
        <div class="meta-label" style="color: var(--severity-info);">INFO</div>
        <div class="stat-number" style="color: var(--severity-info);">{{ risk_summary.info_count }}</div>
      </div>
    </div>

    <h2 class="section-title">1. Findings Ledger Summary</h2>
    <table>
      <thead>
        <tr>
          <th>Severity</th>
          <th>Finding Title</th>
          <th>Engine</th>
          <th>Identifier / CVE</th>
          <th>Location</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {% for f in findings %}
        <tr>
          <td><span class="sev-badge {{ f.severity }}">{{ f.severity }}</span></td>
          <td><strong>{{ f.title }}</strong></td>
          <td>{{ f.scanner_engine }}</td>
          <td>{{ f.cve_id or f.scanner_rule_id }}</td>
          <td><code>{{ f.target_location }}</code></td>
          <td>{{ f.status }}</td>
        </tr>
        {% else %}
        <tr>
          <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 1.5rem;">
            <em>No security vulnerabilities identified in the selected scope.</em>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <h2 class="section-title">2. Detailed Vulnerability Dossiers</h2>
    {% for f in findings %}
    <div class="dossier-card">
      <div class="dossier-header">
        <div class="dossier-title">{{ loop.index }}. {{ f.title }}</div>
        <span class="sev-badge {{ f.severity }}">{{ f.severity }}</span>
      </div>

      <div class="dossier-meta">
        <div><strong>Location:</strong> <code>{{ f.target_location }}</code></div>
        <div><strong>Engine:</strong> {{ f.scanner_engine }} ({{ f.scanner_rule_id }})</div>
        <div><strong>CVSS v3.1:</strong> {{ f.cvss_score or 'N/A' }}</div>
        <div><strong>EPSS:</strong> {% if f.epss_score %}{{ (f.epss_score * 100)|round(1) }}%{% else %}N/A{% endif %}</div>
        <div><strong>CISA KEV:</strong> {% if f.is_kev %}<span style="color: var(--severity-critical); font-weight: bold;">ACTIVE THREAT</span>{% else %}No{% endif %}</div>
      </div>

      <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 0.75rem;">
        {{ f.description }}
      </p>

      {% if f.evidence %}
      <div style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted); margin-top: 0.5rem;">FORENSIC PROOF OF CONCEPT:</div>
      <div class="evidence-block">{% if f.evidence.request %}REQUEST:
{{ f.evidence.request }}

{% endif %}{% if f.evidence.response %}RESPONSE:
{{ f.evidence.response[:500] }}...
{% endif %}{% if f.evidence.matched_content %}MATCHED: {{ f.evidence.matched_content }}{% endif %}{% if not f.evidence.request and not f.evidence.response %}{{ f.evidence }}{% endif %}</div>
      {% elif f.raw_payload %}
      <div class="evidence-block">{{ f.raw_payload }}</div>
      {% endif %}

      {% if f.remediation %}
      <div class="remediation-block">
        <strong>Remediation Guidance:</strong> {{ f.remediation }}
      </div>
      {% endif %}
    </div>
    {% endfor %}

    <h2 class="section-title">3. Coverage Gaps & Exclusions</h2>
    <div class="meta-grid" style="margin-bottom: 1.5rem;">
      <div class="meta-item">
        <div class="meta-label">Coverage Completion</div>
        <div class="meta-value" style="color: var(--accent-cyan); font-weight: 800;">{{ coverage_metrics.coverage_pct if coverage_metrics and coverage_metrics.coverage_pct is defined else '100.0' }}%</div>
      </div>
      <div class="meta-item">
        <div class="meta-label">Unassessed / Excluded Items</div>
        <div class="meta-value">{{ coverage_gaps|length if coverage_gaps else 0 }}</div>
      </div>
    </div>

    {% if coverage_gaps %}
    <table class="findings-table" style="margin-bottom: 2rem;">
      <thead>
        <tr>
          <th>Target</th>
          <th>Engine</th>
          <th>Status</th>
          <th>Exclusion Reason & Scope Justification</th>
          <th>Remediation Suggestion</th>
        </tr>
      </thead>
      <tbody>
        {% for gap in coverage_gaps %}
        <tr>
          <td><code>{{ gap.target_locator or gap.target }}</code></td>
          <td>{{ gap.engine }}</td>
          <td><span class="sev-badge {{ gap.status }}">{{ gap.status }}</span></td>
          <td>{{ gap.reason }}</td>
          <td>{{ gap.remediation_suggestion or 'N/A' }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 0.5rem; padding: 1.25rem; margin-bottom: 2rem; color: var(--severity-low);">
      <strong>Zero Unassessed Exclusions:</strong> 100% of approved in-scope execution targets and security checks executed successfully without timeouts, authorization denials, or unhandled exclusions.
    </div>
    {% endif %}

    <div style="margin-top: 3rem; text-align: center; font-size: 0.8rem; color: var(--text-muted); border-top: 1px solid var(--border-subtle); padding-top: 1rem;">
      Report generated from stored findings. Review confidence, provenance and coverage gaps; a scanner result is not automatically a verified exploit.
    </div>
  </div>

  <script>
    function toggleTheme() {
      const doc = document.documentElement;
      const current = doc.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'warm' : 'dark';
      doc.setAttribute('data-theme', next);
      doc.classList.toggle('theme-warm', next === 'warm');
      document.body.classList.toggle('theme-warm', next === 'warm');
      const btn = document.getElementById('themeBtn');
      if (btn) {
        btn.textContent = next === 'warm' ? 'Theme: Obsidian Dark' : 'Theme: Warm Light';
      }
    }
  </script>
</body>
</html>
