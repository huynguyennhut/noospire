# Copy to deploy/.env (git-ignored) and fill from the secret store. Never commit real values.
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SENTINEL_SECRET_KEY=
SENTINEL_SOLE_OWNER_EMAIL=
# Fixed immutable UUID for the owner account (generate once, keep forever):
#   python -c "import uuid; print(uuid.uuid4())"
SENTINEL_SOLE_OWNER_ACCOUNT_ID=
NOOSPIRE_BUILD_ID=
# Only with --profile tunnel. Use a NEW Named Tunnel token (old tokens were exposed).
CLOUDFLARED_VERSION=
TUNNEL_TOKEN=

# Milestone 4 · scheduler tick and worker host-load guard (percent; 100 disables)
NOOSPIRE_SCHEDULER_TICK_SECONDS=15
SENTINEL_THROTTLE_CPU_PCT=90
SENTINEL_THROTTLE_MEM_PCT=95
